{
  "name": "neuropilot",
  "version": "1.0.2",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "build:ios:debug": "cd ios && xcodebuild -workspace NeuroPilot.xcworkspace -scheme NeuroPilot -configuration Debug -sdk iphonesimulator -derivedDataPath build",
    "build:ios:release": "cd ios && xcodebuild -workspace NeuroPilot.xcworkspace -scheme NeuroPilot -configuration Release -sdk iphoneos -derivedDataPath build",
    "build:eas:android:debug": "eas build --platform android --profile development",
    "build:eas:android:preview": "eas build --platform android --profile preview",
    "build:eas:android:release": "eas build --platform android --profile production",
    "build:eas:ios:debug": "eas build --platform ios --profile development",
    "build:eas:ios:preview": "eas build --platform ios --profile preview",
    "build:eas:ios:release": "eas build --platform ios --profile production",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && xcodebuild -workspace NeuroPilot.xcworkspace -scheme NeuroPilot clean",
    "pods": "cd ios && pod install",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "assets:refresh": "expo prebuild --clean && cd ios && pod install",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest --watchman=false",
    "test:coverage": "jest --coverage --watchman=false",
    "prepare": "husky",
    "bump-version": "node scripts/bump-version.js",
    "ci": "npm run lint && npm run format:check && npm run type-check && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/datetimepicker": "7.6.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "date-fns": "^3.6.0",
    "expo": "~51.0.28",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-notifications": "~0.28.19",
    "expo-splash-screen": "~0.27.6",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-background-timer": "^2.4.1",
    "react-native-gesture-handler": "~2.17.1",
    "react-native-mmkv": "^2.12.2",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.34.0",
    "react-native-svg": "15.3.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "~0.73.0",
    "@types/react-native-background-timer": "^2.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.2",
    "prettier": "^3.8.3",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@notifee/react-native|react-native-background-timer)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/types/**",
      "!src/navigation/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      }
    }
  }
}
