{
  "expo": {
    "name": "NeuroPilot",
    "slug": "neuropilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D19"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.neuropilot.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D19"
      },
      "package": "com.neuropilot.app",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withNotifeeMavenRepo.js",
      "./plugins/withFocusTimerNotification.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2A7A8C",
          "sounds": []
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf",
            "./node_modules/@expo-google-fonts/lexend/500Medium/Lexend_500Medium.ttf",
            "./node_modules/@expo-google-fonts/lexend/600SemiBold/Lexend_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/lexend/700Bold/Lexend_700Bold.ttf",
            "./node_modules/@expo-google-fonts/lexend/800ExtraBold/Lexend_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
