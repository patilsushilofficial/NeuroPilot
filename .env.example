# NeuroPilot Environment Variables Template
# Duplicate this file to '.env' and fill in your actual credentials.
# IMPORTANT: Never commit '.env' files to Git!

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development, staging, production
APP_ENV=development

# ------------------------------------------------------------------------------
# 2. EXPO APPLICATION SERVICES (EAS) CONFIGURATION
# ------------------------------------------------------------------------------
# Used in CI/CD pipeline for cloud builds and deployments
# Find this in your Expo Developer Dashboard under Project Settings.
EXPO_TOKEN=your_expo_access_token_here
EAS_PROJECT_ID=your-eas-project-id

# ------------------------------------------------------------------------------
# 3. NOTIFICATION & PUSH CONTEXT (Optional)
# ------------------------------------------------------------------------------
# If enabling remote notification features in the future
NOTIFICATION_API_KEY=your_notification_api_key_here

# ------------------------------------------------------------------------------
# 4. TELEMETRY & ERROR TRACKING (e.g. Sentry/Bugsnag)
# ------------------------------------------------------------------------------
# Set up crash reporting to catch production runtime failures
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/your-project-id

# ------------------------------------------------------------------------------
# 5. INTEGRATION ALERTS (CI/CD Pipeline Status notifications)
# ------------------------------------------------------------------------------
# Webhook URL for posting build success/failure logs to team chat channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
